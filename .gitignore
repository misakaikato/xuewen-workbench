# dependencies
node_modules/

# build outputs（build/ 同时是 electron-builder 的 buildResources：installer.nsh 要入库）
dist/
dist-ssr/
build/*
!build/installer.nsh
release/
out/
*.tsbuildinfo

# app runtime data (confidential, per-machine)
server/data/
.derived/
**/.derived/

# temp / atomic-write leftovers, caches, local indexes
*.wb-tmp-*
.wb-write-test-*
.cache/
.vite/
*.local
.env
.env.*

# logs
logs/
*.log
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# MLX 离线运行环境（构建期 fetch-mlx-env.mjs 重建，不入库）
resources-mlx/python.tar.gz
resources-mlx/wheels/
__pycache__/
