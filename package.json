{
  "name": "corpus-workbench",
  "private": true,
  "version": "0.1.17",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "electron . --dev",
    "electron:start": "npm run build && electron .",
    "electron:build:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "electron:build:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "release:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish always",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "test:e2e": "npm run build && electron scripts/e2e-editor.mjs",
    "test:retrieval": "node scripts/test-retrieval.mjs",
    "test:retrieval:e2e": "npm run build && electron scripts/e2e-retrieval.mjs && electron scripts/e2e-search-location.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@sinclair/typebox": "^0.34.52",
    "adm-zip": "^0.6.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.10",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "mammoth": "^1.13.0",
    "onnxruntime-node": "^1.30.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^9.39.1",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.17",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "lucide-react": "^0.562.0",
    "opencc-js": "^1.4.2",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "unified": "^11.0.5",
    "vite": "^7.2.4"
  },
  "main": "electron/main.js",
  "productName": "Xuewen Workbench",
  "description": "Corpus workbench",
  "author": "mayu",
  "build": {
    "appId": "local.mayu.corpus-workbench",
    "productName": "Xuewen Workbench",
    "publish": {
      "provider": "github",
      "owner": "misakaikato",
      "repo": "xuewen-workbench"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*.js",
      "server/rag/*.py",
      "schema/**/*.json",
      "electron/**/*",
      "assets/icons/**/*",
      "package.json",
      "!server/data{,/**/*}"
    ],
    "icon": "assets/icons/icon.png",
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "resources-mlx",
          "to": "mlx-env",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/better-sqlite3/**",
      "server/rag/*.py"
    ],
    "afterPack": "./scripts/afterPack-prune.cjs"
  }
}
